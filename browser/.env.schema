# Copy to browser/.env and fill in. Loaded by browser/server.py.
# Anything not set here falls back to the app's .env.<APP_ENV> (default .env.local).

## Required: a password for the browser (HTTP Basic auth). Transcripts are sensitive.
BROWSER_PASSWORD=change-me
BROWSER_USER=research

## Firebase credentials (same as the app). Leave commented to reuse .env.local.
# FIREBASE_CREDS_PATH=./firebase-credentials.json
# FIREBASE_CREDS_JSON=<base64 service-account json>

## OpenAI key for the "Translate to English" button. Optional; the button is
## disabled without it. Translations are cached in memory only.
# OPENAI_API_KEY=sk-...
TRANSLATE_MODEL=gpt-4o-mini

## Must match dashboard/.env so participant ids line up with Grafana.
DASHBOARD_HASH_SALT=change-me-to-the-same-salt-as-the-dashboard

## Listen address. Keep 127.0.0.1 if you put it behind nginx/Caddy; use 0.0.0.0 to expose directly.
BROWSER_HOST=0.0.0.0
BROWSER_PORT=8090

## Show raw phone numbers and WhatsApp profile names in the UI (default: hidden, hashed ids only).
BROWSER_SHOW_PHONE=false

## Seconds between incremental Firestore refreshes; hours of silence before a conversation counts as abandoned.
BROWSER_REFRESH_SECONDS=30
BROWSER_ABANDON_HOURS=24

## Only for a server that is not reachable from outside (e.g. SSH tunnel). Disables auth.
# BROWSER_ALLOW_NO_AUTH=1
