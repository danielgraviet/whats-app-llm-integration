# Copy to webchat/.env and fill in. Loaded by webchat/app.py.
# Never commit webchat/.env.

## Firestore: the SAME project/service account as the WhatsApp app, but a
## different collection so the two studies never mix. The app refuses to run
## against "conversations".
# Phase 1 (Oct 12-19, slider, five arms) is in web_conversations; phase 2 writes to its own collection.
FIRESTORE_COLLECTION=web_conversations_phase2
# One of the two credential forms (same values Railway uses):
# FIREBASE_CREDS_PATH=./firebase-credentials.json
# FIREBASE_CREDS_JSON=<base64 service-account json>
# The Firestore project is taken from the key itself; FIRESTORE_PROJECT overrides it.
# FIRESTORE_PROJECT=urnas-study-2026

## OpenAI (same key as the WhatsApp app; the model is set in integrations/openai_client.py)
OPENAI_API_KEY=sk-...
# Conversation model (must appear in your account's /v1/models list) and
# reasoning effort: none | low | medium | high | xhigh (gpt-5.5 rejects "minimal").
# Changed from gpt-4 on 2026-10-01.
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low

## Study parameters (web defaults, phase 2; shown here for reference)
TRUST_RATING_MIN=1
TRUST_RATING_MAX=7
TRUST_CHECK_INTERVAL=6
DEBRIEF_AFTER_TURNS=24
CONTINUE_AFTER_DEBRIEF=false
# Minutes without a participant message before the open page shows the debrief and closes
WEBCHAT_INACTIVITY_MINUTES=15

## Server: bind to localhost; nginx proxies https://pccgo.cs.byu.edu/pesquisa/ to it
WEBCHAT_HOST=127.0.0.1
WEBCHAT_PORT=8100

## Salt for hashing participant IP addresses (raw IPs are never stored)
WEBCHAT_IP_SALT=change-me-to-a-long-random-string

## Max characters per participant message
WEBCHAT_MAX_MESSAGE_CHARS=2000

## Eligibility screening (18+ and eligible to vote) before the baseline rating
SCREENING_ENABLED=true

## Meta Pixel (Facebook ads). Default is the study's pixel; set it empty
## (META_PIXEL_ID=) to serve the page without any pixel, e.g. on a staging host.
## --demo mode never loads the pixel unless this is set.
META_PIXEL_ID=1276196112839237
