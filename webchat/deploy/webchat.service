# /etc/systemd/system/webchat.service
# Adjust User/WorkingDirectory/ExecStart to where the repo and venv live, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now webchat
#   sudo systemctl status webchat ; journalctl -u webchat -f
[Unit]
Description=Urnas study web chat (webchat/app.py)
After=network.target

[Service]
User=remote
WorkingDirectory=/home/remote/whats-app-llm-integration
Environment=GIT_COMMIT_SHA=
ExecStart=/home/remote/whats-app-llm-integration/.venv/bin/python webchat/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
