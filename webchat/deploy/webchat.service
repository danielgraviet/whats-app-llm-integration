# /etc/systemd/system/webchat.service
#
# BEFORE enabling: set User to the account that owns the checkout, and the two
# paths to where the repo and its .venv live. A wrong User fails with
# "status=217/USER" before Python even starts. Example for a checkout in
# /home/admin owned by admin:
#   sudo sed -i 's/^User=.*/User=admin/; s#/opt/whats-app-llm-integration#/home/admin/whats-app-llm-integration#g' /etc/systemd/system/webchat.service
# then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now webchat
#   sudo systemctl status webchat ; journalctl -u webchat -n 30 --no-pager
[Unit]
Description=Urnas study web chat (webchat/app.py)
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/whats-app-llm-integration
Environment=GIT_COMMIT_SHA=
ExecStart=/opt/whats-app-llm-integration/.venv/bin/python webchat/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
