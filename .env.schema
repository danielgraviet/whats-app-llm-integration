## Environment file selection
# config.py loads .env.${APP_ENV}; use .env.local for local development.
APP_ENV=local

## Firebase / Firestore
# Set exactly one of the following credential sources.
# Local development: path to the Firebase service-account JSON file.
FIREBASE_CREDS_PATH=./firebase-credentials.json
# Production: base64-encoded contents of the Firebase service-account JSON file.
# FIREBASE_CREDS_JSON=

## Meta WhatsApp Business API
PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACC_ID=your_whatsapp_business_account_id
ACCESS_TOKEN=your_meta_whatsapp_access_token
# Token configured in Meta Developer Console for webhook verification.
VERIFY_TOKEN=your_webhook_verify_token

## OpenAI
OPENAI_API_KEY=your_openai_api_key

## Conversation and WhatsApp Flows
# Number of user turns between trust-rating check-ins.
TRUST_CHECK_INTERVAL=3
# Set to true only when WhatsApp Flows are configured in Meta.
USE_FLOWS=false
# Flow IDs for the English and Portuguese WhatsApp Flows.
FLOW_ID_EN=123
FLOW_ID_PT=123
