# Second poller instance for the WEB study. Copy to dashboard/.env.web, then run:
#   DASHBOARD_ENV_FILE=dashboard/.env.web python dashboard/export_to_postgres.py
# It reads Firestore collection web_conversations and writes to the webstudy database.
FIRESTORE_COLLECTION=web_conversations
DASHBOARD_PG_DSN=postgresql://postgres:password@localhost:5432/webstudy
# Use a DIFFERENT salt than the WhatsApp poller if you want ids to be unlinkable across studies,
# or the same one if the conversation browser for the web study should show matching ids.
DASHBOARD_HASH_SALT=change-me
POLL_INTERVAL=30
# Firebase credentials fall back to .env.local / dashboard/.env if not set here
# FIREBASE_CREDS_JSON=
