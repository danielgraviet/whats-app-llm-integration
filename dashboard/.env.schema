# Copy to dashboard/.env and fill in. Loaded by export_to_postgres.py.
# Anything not set here falls back to the app's .env.<APP_ENV> (default .env.local),
# which is where the Firebase credentials usually already live.

## Dashboard database (the TimescaleDB container from docker-compose.yml)
DASHBOARD_PG_DSN=postgresql://postgres:password@localhost:5432/postgres

## Salt for hashing participant phone numbers. Pick a long random string once and
## never change it; changing it splits every participant into a new row.
DASHBOARD_HASH_SALT=change-me-to-a-long-random-string

## Seconds between Firestore polls
POLL_INTERVAL=30

## Firebase credentials. Leave commented out to reuse the app's .env.local.
# FIREBASE_CREDS_PATH=./firebase-credentials.json
# FIREBASE_CREDS_JSON=<base64 service-account json>

## Which app env file to fall back to (.env.<APP_ENV>)
# APP_ENV=local
